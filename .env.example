# ───────────────────────────────────────────────
#  PhiloCompass — environment template
#  Copy to `.env` and fill in. Never commit `.env`.
#  (The `.env` file is git-ignored.)
# ───────────────────────────────────────────────

# The app WORKS without a key: it falls back to a rich
# offline Socratic-tutor engine. Set a key to unlock the
# full LLM-driven dialogue. Use an OpenAI-compatible gateway
# (RouteLLM, OpenRouter, etc.) by pointing BASE_URL at it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://routellm.abacus.ai/v1

# Models (must be routable names on your gateway)
SOCRATES_MODEL=route-llm
MAP_MODEL=route-llm
